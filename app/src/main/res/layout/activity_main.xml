<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#0A0A0A"
    android:gravity="center_vertical">

    <!-- Английский заголовок -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="INTERNET CHECKER"
        android:textColor="#FCEE0A"
        android:textSize="24sp"
        android:textStyle="bold"
        android:fontFamily="monospace"
        android:layout_marginBottom="30dp" />

    <!-- Главная кнопка -->
    <Button
        android:id="@+id/btnCheck"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@drawable/cyber_button"
        android:text="ЗАПУСТИТЬ СКАНЕР"
        android:textColor="#000000"
        android:textSize="18sp"
        android:textStyle="bold"
        android:fontFamily="monospace"
        android:layout_marginBottom="30dp" />

    <!-- Поле вывода статуса -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text="[ОЖИДАНИЕ КОМАНДЫ...]"
        android:textColor="#00FFFF"
        android:textSize="16sp"
        android:fontFamily="monospace"
        android:lineSpacingExtra="6dp" />

    <!-- Нижняя панель: Ссылка на GitHub слева, кнопка логов справа -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="10dp">

        <!-- Кликабельная подпись автора -->
        <TextView
            android:id="@+id/tvAuthor"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="by GenKo(piwko0_0)"
            android:textColor="#888888"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:padding="8dp" />

        <!-- Кнопка логов -->
        <Button
            android:id="@+id/btnLogs"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:backgroundTint="#1A1A1A"
            android:text="[ ЛОГИ ]"
            android:textColor="#FCEE0A"
            android:textSize="12sp"
            android:fontFamily="monospace" />

    </LinearLayout>

</LinearLayout>